{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "EnableDevTokens": false,
    "Jwt": {
      "Issuer": "rbac-demo",
      "Audience": "rbac-demo-api",
      "TokenLifetimeMinutes": 60
    }
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=rbac-demo.db",
    "InitializeOnStartup": true,
    "SeedDemoData": false
  }
}
